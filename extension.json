{
  "extensionId": "snapzones",
  "name": "SnapZones",
  "description": "FancyZones-style window placement and native Super-drag snapping for ii-vynx and Hyprland.",
  "version": "0.2.0",
  "author": "ii-vynx community",
  "icon": "dashboard",
  "shapeString": "Cookie9Sided",
  "configDefaults": {
    "enabled": true,
    "layout": "halves",
    "gap": 12,
    "padding": 12,
    "overlayOpacity": 0.86,
    "zoneColor": "#8ab4f8",
    "showLabels": true,
    "floatOnPlacement": true,
    "dragToZone": true,
    "dragDropDelayMs": 70,
    "cursorSampleIntervalMs": 16
  },
  "configSchema": {
    "enabled": {
      "type": "bool",
      "label": "Enable SnapZones",
      "icon": "select_window",
      "default": true
    },
    "layout": {
      "type": "enum",
      "label": "Default Layout",
      "icon": "dashboard",
      "default": "halves",
      "options": [
        { "displayName": "Halves", "value": "halves" },
        { "displayName": "Thirds", "value": "thirds" },
        { "displayName": "Main + Side", "value": "main-side" },
        { "displayName": "Four Quadrants", "value": "quadrants" },
        { "displayName": "Ultrawide", "value": "ultrawide" },
        { "displayName": "Full Screen", "value": "fullscreen" }
      ]
    },
    "gap": {
      "type": "int",
      "label": "Zone Gap",
      "icon": "space_bar",
      "default": 12,
      "min": 0,
      "max": 80
    },
    "padding": {
      "type": "int",
      "label": "Work Area Padding",
      "icon": "padding",
      "default": 12,
      "min": 0,
      "max": 80
    },
    "overlayOpacity": {
      "type": "slider",
      "label": "Overlay Opacity",
      "icon": "opacity",
      "default": 0.86,
      "min": 0.2,
      "max": 1.0
    },
    "zoneColor": {
      "type": "string",
      "label": "Zone Color",
      "icon": "palette",
      "default": "#8ab4f8"
    },
    "showLabels": {
      "type": "bool",
      "label": "Show Zone Labels",
      "icon": "numbers",
      "default": true
    },
    "floatOnPlacement": {
      "type": "bool",
      "label": "Float Tiled Windows",
      "icon": "open_in_full",
      "default": true
    },
    "dragToZone": {
      "type": "bool",
      "label": "Enable Super-drag snapping",
      "icon": "pan_tool_alt",
      "default": true
    },
    "dragDropDelayMs": {
      "type": "int",
      "label": "Drag drop settling delay",
      "icon": "timer",
      "default": 70,
      "min": 20,
      "max": 250
    },
    "cursorSampleIntervalMs": {
      "type": "int",
      "label": "Cursor sampling interval",
      "icon": "speed",
      "default": 16,
      "min": 8,
      "max": 1000
    }
  },
  "contributes": {
    "services": [
      { "id": "zoneManager", "qml": "src/services/ZoneManager.qml" }
    ],
    "cheatsheet": [
      {
        "identifier": "zones",
        "title": "Zones",
        "icon": "dashboard",
        "component": "src/cheatsheet/ZoneCheatsheet.qml"
      }
    ]
  }
}
